  m_Script: {fileID: 11500000, guid: 000884bc5cb1d134d949abd6ea8f3557, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Estatua
  nombre: "El Moh\xE1n"
  descripcion: "El Moh\xE1n es un ser m\xEDtico del folclor fluvial colombiano, especialmente
    arraigado en la cuenca del r\xEDo Magdalena, representado como un hombre anciano
    de cabellera larga y aspecto salvaje que habita en cuevas subterr\xE1neas bajo
    las aguas. \n\nConsiderado tanto protector de los r\xEDos como una figura seductora
    y traviesa para pescadores y lavanderas, este personaje simboliza la fuerza ind\xF3mita
    de los caudales, la abundancia de la pesca y el respeto ancestral hacia los ecosistemas
    acu\xE1ticos."
  imagenesDerrota:
  - {fileID: 21300000, guid: 240c0dae8c626d14a996d460b1ba06ba, type: 3}
  - {fileID: 21300000, guid: 4ccb057825e89174e8e4e8126dcf5ac4, type: 3}
